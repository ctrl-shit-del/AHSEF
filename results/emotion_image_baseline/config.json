  "class_weight_policy": "inverse_frequency_from_train",
  "device": "cpu",
  "checkpoint_dir": "checkpoints/emotion_image_baseline",
  "results_dir": "results/emotion_image_baseline",
  "max_train_samples": null,
  "max_val_samples": null,
  "max_test_samples": null
